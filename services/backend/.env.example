# Backend API — copy to .env (docker-compose overrides DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://pokemon_user:pokemon_password@localhost:5432/pokemon_intel
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Signs JWTs and the one-click unsubscribe links. The analysis service needs the same value.
SECRET_KEY=change-me-to-a-long-random-string

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Stripe (optional locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PAID=
STRIPE_PRICE_PRO=

# Email: Brevo API (preferred) or SMTP. SMTP_FROM must be a verified Brevo sender.
BREVO_API_KEY=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_INBOX_EMAIL=

# Backend API — copy to .env (docker-compose overrides DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://pokemon_user:pokemon_password@localhost:5432/pokemon_intel
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Signs JWTs and the one-click unsubscribe links. The analysis service needs the same value.
SECRET_KEY=change-me-to-a-long-random-string

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Stripe (optional locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PAID=
STRIPE_PRICE_PRO=

# Email: Gmail API over HTTPS (works on Railway Hobby; see docs/email-gmail-api.md)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Or SMTP (needs Railway Pro; Gmail: SMTP_USER = Gmail address, SMTP_PASSWORD = Google app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FEEDBACK_INBOX_EMAIL=

# Analysis — copy to .env (docker-compose overrides DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://pokemon_user:pokemon_password@localhost:5432/pokemon_intel

# Watchlist alert emails (same values as the backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
# Must equal the backend SECRET_KEY (signs unsubscribe links)
SECRET_KEY=change-me-to-a-long-random-string

# Optional tuning, see app/config_analysis.py (prefix ANALYSIS_)
# ANALYSIS_INCLUDED_LANGUAGES=["EN"]
# ANALYSIS_RAW_PRICES_RETENTION_DAYS=3
# ANALYSIS_DAILY_PRICES_RETENTION_DAYS=180
# ANALYSIS_LONG_WINDOW_DAYS=30

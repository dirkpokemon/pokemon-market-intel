# Scraper — copy to .env (docker-compose overrides DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://pokemon_user:pokemon_password@localhost:5432/pokemon_intel

# CardTrader API token (cardtrader.com → account → API)
CARDTRADER_API_TOKEN=

# CardMarket MKM API (optional; the scrape is skipped when any of these is empty)
CARDMARKET_APP_TOKEN=
CARDMARKET_APP_SECRET=
CARDMARKET_ACCESS_TOKEN=
CARDMARKET_ACCESS_TOKEN_SECRET=

# Keys the pseudonymous seller hash (any long random string)
SELLER_KEY_SECRET=

# Long-running mode only (Railway runs `python -m app.main --once` on a cron)
SCRAPE_INTERVAL=720
